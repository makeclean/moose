[Tests]
  issues = '#99999999'
  design = 'GrayDiffuseRadiation.md VacuumRayViewFactorStudy.md VacuumRayViewFactor.md PatchSidesetGenerator.md'

  [convex_escape]
    type = 'CSVDiff'
    input = 'convex_escape.i'
    csvdiff = 'convex_escape_out.csv'
    requirement = 'The system shall compute radiative exchange between surfaces radiating into an open (vacuum) environment with view_factor_calculator = vacuum_ray_tracing, such that for a convex geometry all radiation escapes, the fixed temperature surface emits its black body flux sigma T^4, and adiabatic surfaces exchange no heat.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [black_body_environment]
    type = 'CSVDiff'
    input = 'black_body_environment.i'
    csvdiff = 'black_body_environment_out.csv'
    requirement = 'The system shall allow open geometries to exchange radiation with a black body environment at a user-specified environment_temperature using view_factor_calculator = vacuum_ray_tracing and environment = black_body, such that a convex surface at temperature T loses flux sigma (T^4 - T_environment^4) and adiabatic surfaces equilibrate to the environment temperature.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [open_box]
    type = 'CSVDiff'
    input = 'open_box.i'
    csvdiff = 'open_box_out.csv'
    rel_err = 1e-2 # gold values computed from an independent discrete replica of the ray tracing quadrature
    requirement = 'The system shall compute mutual radiative exchange between the walls of an open (hollow) geometry by ray tracing with view_factor_calculator = vacuum_ray_tracing, including the escape fraction of radiation leaving through the opening, such that a heated wall heats the adiabatic walls to a temperature below the heated wall temperature.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [two_cubes]
    type = 'CSVDiff'
    input = 'two_cubes.i'
    csvdiff = 'two_cubes_out.csv'
    requirement = 'The system shall compute coupled steady-state conduction and radiative exchange between two separated cubes by ray tracing with view_factor_calculator = vacuum_ray_tracing, such that with the bottom faces held at 4000 K and 400 K, the eight outer faces adiabatic, and the two facing inner faces free, heat flows from the hot cube to the cold cube by conduction and radiation across the gap, the inner-face radiative fluxes are in the hot-to-cold direction, and the adiabatic faces exchange no net radiation.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [two_cubes_patched]
    type = 'CSVDiff'
    input = 'two_cubes_patched.i'
    csvdiff = 'two_cubes_patched_out.csv'
    requirement = 'The system shall subdivide each radiating sideset of the vacuum_ray_tracing view factor calculation into the requested number of radiation patches (n_patches > 1) using the PatchSidesetGenerator, such that for two facing cube faces held at 400 K and 300 K the per-patch temperatures equal the prescribed values, the per-patch view factors satisfy reciprocity for every patch pair, and the per-patch net heat flux on each face is within 0.1% of the lumped (n_patches = 1) face-average result.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [two_cubes_facet]
    type = 'CSVDiff'
    input = 'two_cubes_facet.i'
    csvdiff = 'two_cubes_facet_out.csv'
    requirement = 'The system shall create one radiation patch per facet of a radiating sideset when n_patches = 0, ignoring the requested partitioner, such that for two facing cube faces held at 400 K and 300 K the per-patch temperatures equal the prescribed values, the per-patch view factors satisfy reciprocity for every patch pair, and the per-patch net heat flux on each face is within 1% of the coarse (n_patches = 4) patch result.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []

  [sphere_cube]
    type = 'CSVDiff'
    input = 'sphere_cube.i'
    csvdiff = 'sphere_cube_out.csv'
    requirement = 'The system shall compute coupled steady-state conduction and radiative exchange between a box and a sphere separated by a gap by ray tracing with view_factor_calculator = vacuum_ray_tracing, such that with the box left face held at 4000 K, the other four box faces adiabatic, and the box right face and sphere surface free and subdivided into one patch per facet, heat flows from the box left face by conduction to the box right face and then by radiation across the gap to the sphere, the sphere warms from its initial temperature, and the adiabatic faces exchange no net radiation.'
    capabilities = 'xdg'
    mesh_mode = REPLICATED # the vacuum ray tracing view factor calculation requires a serial replicated mesh
  []
[]